{$DOMAIN} {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /health* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}

dmv2.kochfe.de {
    handle /api/* {
        reverse_proxy dmv2-backend:8000
    }

    handle /health* {
        reverse_proxy dmv2-backend:8000
    }

    handle {
        reverse_proxy dmv2-frontend:3000
    }
}
